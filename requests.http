### Login
# Gets a token from the Duende demo identity server and saves it for the next requests.
POST https://demo.duendesoftware.com/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=m2m&client_secret=secret&scope=api

> {%
    client.test("Token received", () => {
        client.assert(response.status === 200, "Status: " + response.status);
        client.assert(response.body.access_token, "No access_token in the response");
    });
    client.global.set("token", response.body.access_token);
%}

### Enqueue an estimation
# Saves the returned ticket for the status request.
POST https://localhost:5000/estimations
Content-Type: application/json
Authorization: Bearer {{token}}
# Repeating the request with the same key returns the same ticket instead of starting a second case.
Idempotency-Key: {{$uuid}}

{
  "callBackUri": "https://localhost:5004/Notification",
  "imageUrls": [
    "https://localhost:5001/images/image01.png",
    "https://localhost:5001/images/image02.jpg"
  ]
}

> {%
    client.test("Estimation accepted", () => {
        client.assert(response.status === 202, "Status: " + response.status);
    });
    client.global.set("ticket", response.body.token);
%}

### Get estimation status
GET https://localhost:5000/estimations/{{ticket}}
Authorization: Bearer {{token}}
