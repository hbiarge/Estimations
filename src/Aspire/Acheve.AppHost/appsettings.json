{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // The customers that get their own label on the case metrics (and their own Keycloak client, see keycloak/).
  // Any other customer is counted as "other": a label value is a time series, so the list must stay short.
  "Customers": {
    "Known": [ "acme", "globex", "initech" ]
  },
  "ExternalSystems": {
    "external-images": "https://external-images.dev.localhost:5001/",
    "external-imageprocess": "https://external-imageprocess.dev.localhost:5002/",
    "external-estimations": "https://external-estimations.dev.localhost:5003/",
    // One fake notification endpoint per customer in Customers:Known (the External AppHost runs them).
    "external-notifications-acme": "https://external-notifications-acme.dev.localhost:5020/",
    "external-notifications-globex": "https://external-notifications-globex.dev.localhost:5021/",
    "external-notifications-initech": "https://external-notifications-initech.dev.localhost:5022/"
  }
}
