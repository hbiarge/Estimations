      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{service_name}} {{severity_text}}",
          "expr": "sum by (service_name, severity_text) (count_over_time({service_name=~\"$service\"} | severity_text=~\"Error|Critical|Warning\" [$__auto]))"
