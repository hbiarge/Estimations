        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Exceptions thrown",
      "description": "Every exception thrown, including handled ones (HTTP retries, cancelled requests).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
