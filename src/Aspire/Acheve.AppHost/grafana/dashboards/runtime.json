            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, error_type) (rate(dotnet_exceptions_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{error_type}}"
        }
