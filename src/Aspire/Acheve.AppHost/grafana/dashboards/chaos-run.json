    {
      "id": 9,
      "type": "row",
      "title": "Chaos",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Chaos scenario per service",
      "description": "The scenario each service was in, from the services themselves (chaos_scenario_active), whether the chaos monkey or a dashboard command switched it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (service_name) (chaos_scenario_active{chaos_scenario=\"flaky\"}) * 1) + (max by (service_name) (chaos_scenario_active{chaos_scenario=\"slow\"}) * 2) + (max by (service_name) (chaos_scenario_active{chaos_scenario=\"down\"}) * 3) + (max by (service_name) (chaos_scenario_active{chaos_scenario=\"lost-callbacks\"}) * 4) + (max by (service_name) (chaos_scenario_active{chaos_scenario=\"duplicate-callbacks\"}) * 5) + (max by (service_name) (chaos_scenario_active{chaos_scenario=\"custom\"}) * 6)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "healthy",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "flaky",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "slow",
                  "color": "blue",
                  "index": 2
                },
                "3": {
                  "text": "down",
                  "color": "red",
                  "index": 3
                },
                "4": {
                  "text": "lost-callbacks",
                  "color": "purple",
                  "index": 4
                },
                "5": {
                  "text": "duplicate-callbacks",
                  "color": "orange",
                  "index": 5
                },
                "6": {
                  "text": "custom",
                  "color": "text",
                  "index": 6
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Chaos injections",
      "description": "Faults, latency and callback misbehaviour injected per minute, by service and kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, chaos_kind) (rate(chaos_injections_total[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}} {{chaos_kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Chaos monkey steps",
      "description": "Each step of the chaos monkey's plan, and the targets it couldn't reach.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"chaosmonkey\"} |~ \"Chaos step|Couldn't switch|back to healthy\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Resilience",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Resilience profile per service",
      "description": "The resilience profile of each service's HttpClient (resilience_profile_active), switched with the Resilience: <profile> dashboard commands or PUT /resilience.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(max by (service_name) (resilience_profile_active{resilience_profile=\"none\"}) * 1) + (max by (service_name) (resilience_profile_active{resilience_profile=\"retry-only\"}) * 2) + (max by (service_name) (resilience_profile_active{resilience_profile=\"fail-fast\"}) * 3) + (max by (service_name) (resilience_profile_active{resilience_profile=\"hedging\"}) * 4) + (max by (service_name) (resilience_profile_active{resilience_profile=\"custom\"}) * 5)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "standard",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "none",
                  "color": "red",
                  "index": 1
                },
                "2": {
                  "text": "retry-only",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "fail-fast",
                  "color": "purple",
                  "index": 3
                },
                "4": {
                  "text": "hedging",
                  "color": "blue",
                  "index": 4
                },
                "5": {
                  "text": "custom",
                  "color": "text",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 22,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Resilience events",
      "description": "What the resilience strategies of the four callers did per minute (Polly's resilience_polly_strategy_events, without the debug PipelineExecuting events): retries, hedges, timeouts, circuit breaker opening and closing, rejected calls. Nothing shows with the none profile.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, event_name) (rate(resilience_polly_strategy_events_total{service_name=~\"imagedownloads|imageprocessor|estimationprocessor|callbacknotifier\", event_severity!=\"Debug\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}} {{event_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 23,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Calls to external systems",
      "description": "HTTP requests per minute the callers really sent to the external systems, every retry and hedged attempt included (HTTP/2 is left out: it is the services' own telemetry export). Retries against an outage multiply it; an open circuit breaker drops it to almost nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_client_request_duration_seconds_count{service_name=~\"imagedownloads|imageprocessor|estimationprocessor|callbacknotifier\", network_protocol_version!=\"2\"}[$__rate_interval])) * 60",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 24,
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "What clients saw (traffic generator)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cases ended by outcome",
      "description": "Cases per minute that ended, by outcome as the client sees it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (traffic_outcome) (rate(traffic_cases_finished_total[$__rate_interval])) * 60",
          "legendFormat": "{{traffic_outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "notification_failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "timed_out"
            },
