{
  "uid": "estimations-chaos-run",
  "title": "Estimations / Chaos run",
  "description": "What broke, when, what protected the calls, and what clients saw: the chaos scenario and resilience profile of each service next to the traffic generator's outcomes and durations.",
  "tags": [
    "estimations"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Chaos changes",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "{service_name=~\".+\"} |= \"Chaos scenario changed\"",
        "instant": false,
        "tagKeys": "service_name",
        "titleFormat": "Chaos: {{service_name}}"
      },
      {
        "name": "Resilience changes",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{service_name=~\".+\"} |= \"Resilience profile changed\"",
        "instant": false,
        "tagKeys": "service_name",
        "titleFormat": "Resilience: {{service_name}}"
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "estimations"
      ],
      "asDropdown": false,
      "title": "Estimations",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Run",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Client success rate",
      "description": "Cases the traffic generator saw succeed, out of those that ended, in the selected time range. 'failed' cases were told about their failure; they still count as not succeeded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traffic_cases_finished_total{traffic_outcome=\"succeeded\"}[$__range])) / clamp_min(sum(increase(traffic_cases_finished_total[$__range])), 1e-9)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Cases ended",
      "description": "Cases of the traffic generator that ended (any outcome) in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(traffic_cases_finished_total[$__range]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Client p95 duration",
      "description": "From the Api accepting the case to the poll that saw it end, in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(traffic_case_duration_seconds_bucket[$__range])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "In flight",
      "description": "Cases the traffic generator started and is still following.",
