        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_response_status_code) (rate(http_client_request_duration_seconds_count{network_protocol_version=\"1.1\"}[$__rate_interval]))",
