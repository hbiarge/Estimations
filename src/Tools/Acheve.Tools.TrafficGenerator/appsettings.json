{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      // Polly logs every HTTP attempt at Information; with a poll per case every second that's a flood.
      "Polly": "Warning"
    }
  },
  "Traffic": {
    // Average new cases per minute. Arrivals are random (Poisson), so the gaps between cases vary.
    // The fake external systems run up to 20 jobs at a time (10 s each, about 120 a minute), and a case has 1 to 3 images:
    // above about 60 cases per minute the image analysis queue grows and cases get slower and slower.
    "CasesPerMinute": 6,
    // Steady, Wave (the rate swings between 50% and 150% over WavePeriod) or Bursts (BurstSize extra cases every BurstEvery).
    "Pattern": "Steady",
    "WavePeriod": "00:10:00",
    "BurstEvery": "00:05:00",
    "BurstSize": 20,
    "MaxImagesPerCase": 3,
    // Share of cases with one image URL that doesn't exist, to exercise the download failure path.
    "BrokenImageRate": 0.05,
    "PollInterval": "00:00:01",
    "CaseTimeout": "00:15:00",
    "MaxCasesInFlight": 300,
    // The AppHost sets CallbackUrl, ImageUrls and BrokenImageUrl from the external systems' URLs.
    "Token": {
      // The Duende demo identity server the Api trusts (see requests.http). The token is cached until it expires.
      "Authority": "https://demo.duendesoftware.com",
      "ClientId": "m2m",
      "ClientSecret": "secret",
      "Scope": "api"
    }
  }
}
