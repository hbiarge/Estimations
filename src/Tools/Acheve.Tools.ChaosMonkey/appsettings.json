{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "ChaosMonkey": {
    // Timeline: the steps below, in order. Random: random scenarios on random targets (see Random).
    "Mode": "Timeline",
    // Start the timeline again after the last step. Without it, every target goes back to healthy at the end.
    "Repeat": true,
    // Each step sets these scenarios for Duration; every target it doesn't name goes back to healthy.
    // Targets: api, external-images, external-imageprocess, external-estimations, external-notifications.
    // lost-callbacks and duplicate-callbacks only exist on external-imageprocess and external-estimations.
    "Timeline": [
      { "Name": "Baseline", "Duration": "00:02:00" },
      {
        "Name": "Flaky image analysis (retries hide most of it)",
        "Duration": "00:03:00",
        "Scenarios": { "external-imageprocess": "flaky" }
      },
      { "Name": "Calm", "Duration": "00:01:00" },
      {
        "Name": "Slow estimations",
        "Duration": "00:02:00",
        "Scenarios": { "external-estimations": "slow" }
      },
      {
        "Name": "Lost image analyses (wait timeouts)",
        "Duration": "00:03:00",
        "Scenarios": { "external-imageprocess": "lost-callbacks" }
      },
      { "Name": "Calm", "Duration": "00:01:00" },
      {
        "Name": "Client endpoint down",
        "Duration": "00:02:00",
        "Scenarios": { "external-notifications": "down" }
      },
      {
        "Name": "Flaky callbacks and duplicate estimations",
        "Duration": "00:02:00",
        "Scenarios": { "api": "flaky", "external-estimations": "duplicate-callbacks" }
      },
      { "Name": "Recovery", "Duration": "00:02:00" }
    ],
    "Random": {
      "MinDuration": "00:01:00",
      "MaxDuration": "00:03:00",
      // Healthy time between two random steps; 0 for none.
      "HealthyGap": "00:01:00",
      // Up to this many targets misbehave at the same time.
      "MaxTargets": 1
    }
  }
}
