{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "ChaosMonkey": {
    // The strategies the monkey can run, by name. Start one from the chaosmonkey resource's commands in the Aspire
    // dashboard (Strategy: <name>) or with POST /strategies/{name}. Every name needs a dashboard command
    // (Constants.ChaosMonkey.Strategies), so add new ones there too.
    //
    // A strategy is either Steps (in order; over and over when Repeat is on) or Random.
    // Each step sets, for Duration:
    // - Chaos: scenario per target (api, external-images, external-imageprocess, external-estimations,
    //   external-notifications); the targets it doesn't name go back to healthy.
    //   lost-callbacks and duplicate-callbacks only exist on external-imageprocess and external-estimations.
    // - Resilience: profile per caller (imagedownloads, imageprocessor, estimationprocessor, callbacknotifier);
    //   the callers it doesn't name go back to standard.
    // - Consumption: paused or running per worker (imagedownloads, imageprocessor, estimationprocessor,
    //   callbacknotifier, processmanager, stateholder); the workers it doesn't name go back to running.
    // When a strategy ends, is stopped or another one starts, every target goes back to healthy, every caller to
    // standard and every worker to running.
    //
    // The learning strategies last about 5 minutes: a healthy baseline, a phase without and a phase with the strategy
    // (2 minutes each, so the Grafana rates can show them), and a recovery. Run the traffic generator meanwhile.
    "Strategies": {
      "retries": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Flaky image analysis, no resilience (failures reach the cases)",
            "Duration": "00:02:00",
            "Chaos": { "external-imageprocess": "flaky" },
            "Resilience": { "imageprocessor": "none" }
          },
          {
            "Name": "Flaky image analysis, standard resilience (retries hide it)",
            "Duration": "00:02:00",
            "Chaos": { "external-imageprocess": "flaky" }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      "retry-storm": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Images down, retries only (every call becomes four)",
            "Duration": "00:02:00",
            "Chaos": { "external-images": "down" },
            "Resilience": { "imagedownloads": "retry-only" }
          },
          {
            "Name": "Images down, fail fast (the circuit opens)",
            "Duration": "00:02:00",
            "Chaos": { "external-images": "down" },
            "Resilience": { "imagedownloads": "fail-fast" }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      "hedging": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Flaky estimations, standard resilience (slow answers set the pace)",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "flaky" }
          },
          {
            "Name": "Flaky estimations, hedging (the first good answer wins)",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "flaky" },
            "Resilience": { "estimationprocessor": "hedging" }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      "timeouts": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Slow estimations, standard resilience (slow but successful)",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "slow" }
          },
          {
            "Name": "Slow estimations, fail fast (the 3 s timeout fails them)",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "slow" },
            "Resilience": { "estimationprocessor": "fail-fast" }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      "backlog": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Image downloads paused 1 min (only latency)",
            "Duration": "00:01:00",
            "Consumption": { "imagedownloads": "paused" }
          },
          { "Name": "Drain", "Duration": "00:01:30" },
          {
            "Name": "Image downloads paused 3 min (past the saga's 2 min wait: failed cases)",
            "Duration": "00:03:00",
            "Consumption": { "imagedownloads": "paused" }
          },
          { "Name": "Recovery", "Duration": "00:02:00" }
        ]
      },
      "callbacks": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Lost image analyses (HTTP resilience can't see it; the saga's timeouts do)",
            "Duration": "00:03:00",
            "Chaos": { "external-imageprocess": "lost-callbacks" }
          },
          {
            "Name": "Duplicate estimations (the saga ignores the second one)",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "duplicate-callbacks" }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      "bad-day": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:00:30" },
          {
            "Name": "Bad day (several things wrong at once)",
            "Duration": "00:04:00",
            "Chaos": {
              "external-imageprocess": "flaky",
              "external-estimations": "slow",
              "external-notifications": "down",
              "api": "flaky"
            }
          },
          { "Name": "Recovery", "Duration": "00:01:00" }
        ]
      },
      // An incident for the on-call agent demo (talk E5, about 21 minutes): the estimations get slow, and 4 minutes
      // later someone tightens the timeout. Cases only fail from the second change on, long enough to fire the
      // Case failure rate alert on the on-call Grafana.
      "incident": {
        "Steps": [
          { "Name": "Baseline", "Duration": "00:02:00" },
          {
            "Name": "The estimation service gets slow",
            "Duration": "00:04:00",
            "Chaos": { "external-estimations": "slow" }
          },
          {
            "Name": "Someone tightens the timeout (fail fast)",
            "Duration": "00:12:00",
            "Chaos": { "external-estimations": "slow" },
            "Resilience": { "estimationprocessor": "fail-fast" }
          },
          { "Name": "Recovery", "Duration": "00:03:00" }
        ]
      },
      // A long tour of the chaos scenarios (about 18 minutes), over and over.
      "tour": {
        "Repeat": true,
        "Steps": [
          { "Name": "Baseline", "Duration": "00:02:00" },
          {
            "Name": "Flaky image analysis (retries hide most of it)",
            "Duration": "00:03:00",
            "Chaos": { "external-imageprocess": "flaky" }
          },
          { "Name": "Calm", "Duration": "00:01:00" },
          {
            "Name": "Slow estimations",
            "Duration": "00:02:00",
            "Chaos": { "external-estimations": "slow" }
          },
          {
            "Name": "Lost image analyses (wait timeouts)",
            "Duration": "00:03:00",
            "Chaos": { "external-imageprocess": "lost-callbacks" }
          },
          { "Name": "Calm", "Duration": "00:01:00" },
          {
            "Name": "Client endpoint down",
            "Duration": "00:02:00",
            "Chaos": { "external-notifications": "down" }
          },
          {
            "Name": "Flaky callbacks and duplicate estimations",
            "Duration": "00:02:00",
            "Chaos": { "api": "flaky", "external-estimations": "duplicate-callbacks" }
          },
          { "Name": "Recovery", "Duration": "00:02:00" }
        ]
      },
      // Random scenarios on random targets, endlessly. Resilience stays standard.
      "random": {
        "Random": {
          "MinDuration": "00:01:00",
          "MaxDuration": "00:03:00",
          // Healthy time between two random steps; 0 for none.
          "HealthyGap": "00:01:00",
          // Up to this many targets misbehave at the same time.
          "MaxTargets": 1
        }
      }
    }
  }
}
