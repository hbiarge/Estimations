{
  "AllowedHosts": "*",
  "Chaos": {
    // Only our side of the external systems' callbacks; the customer API stays out of the chaos.
    "Paths": [ "/callbacks" ]
  },
  "Limits": {
    // Largest request body (1 MiB). Over it the Api answers 413.
    "MaxRequestBodyBytes": 1048576,
    // Requests per minute. Over them the Api answers 429 with a Retry-After header.
    // Per customer:
    "CreateEstimationsPerMinute": 120,
    "ReadEstimationsPerMinute": 1200,
    // Per address (the callbacks are anonymous):
    "CallbacksPerMinute": 600
  }
}
