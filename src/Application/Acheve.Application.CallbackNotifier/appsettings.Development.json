{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Outbound": {
    // The customers' fake callback endpoints run on localhost. Outside Development private addresses stay blocked.
    "AllowPrivateAddresses": true
  },
  "CustomerCallbacks": {
    "SigningKey": "development-only-customer-callback-signing-key"
  }
}
