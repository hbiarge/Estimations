{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Outbound": {
    // The customers' fake callback endpoints run on localhost. Outside Development private addresses stay blocked.
    "AllowPrivateAddresses": true
  },
  "CustomerCallbacks": {
    // One key per customer: the application signs each customer's notifications with theirs and the fake endpoint of
    // that customer checks with the same one. Development only: real keys come from the environment or a secret store.
    "SigningKeys": {
      "acme": "development-only-acme-callback-signing-key",
      "globex": "development-only-globex-callback-signing-key",
      "initech": "development-only-initech-callback-signing-key"
    }
  }
}
